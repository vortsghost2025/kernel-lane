# Ignore build outputs and local profiler caches
build/
*.obj
*.o
*.pdb
*.exe
*.dll
*.so
*.dylib
*.ptx
*.cubin
*.nvvp
*.nsys-rep
*.qdrep
*.sqlite
*.ncu-rep
*.ncu-rep.gz
*.log
*.bak
nul

# Keep release evidence and reports tracked
!releases/
!benchmarks/reports/
!profiles/

# Cryptographic material — never commit signatures or keys
*.jws
*.pem
.identity/
.runtime/

# API keys (NEVER commit)
.env
.env.local
.env.production

# Signed message sidecars (JWS signatures stored separately)
lanes/**/signature-*.jws

# Local operational files
lanes/*/outbox/unsigned/
logs/quarantine-tracker.json
.aider*
scripts/test-signed-message.js.tmp

# Identity keys (NEVER commit)
keys.json

# Session memory (persists locally)
.memory/
.identity/*.pem

# Sensitive
sensitive/

# Gate violations log
gate-violations.jsonl

# Heartbeat files (ephemeral)
heartbeat-*.json

# Runtime state churn (local-only operational state)
lanes/broadcast/system_state.json

# Inbox/outbox are LOCAL-ONLY
lanes/*/inbox/
lanes/*/outbox/

# Compact audit runtime state
.compact-audit/*.json
.compact-audit/*.jsonl
COMPACT_CONTEXT_HANDOFF.md

# Lane runtime artifacts
lanes/broadcast/last-recovery.json
lanes/broadcast/operator_alert_*.json
lanes/broadcast/hygiene/**
lanes/broadcast/quarantine/**
lanes/*/receipts/
lanes/*/state/active-owner.json
lanes/*/state/worker-audit.log
lanes/*/state/traces/
lanes/*/state/sovereignty-report-*.json
lanes/*/reports/
lanes/kernel/journal/
lanes/archivist/journal/
lanes/library/journal/
lanes/swarmmind/journal/

# Blocked-remediator reports (generated every cycle)
context-buffer/blocked-remediation-report-*.json

# Temp files
*.local

# Cursor IDE settings
.cursor/settings.json

# Node.js runtime (not a Node project)
node_modules/
package.json
package-lock.json

# Playwright test artifacts
test-results/

S:/
JOURNAL_SESSION_ID

# Hygiene/operator timestamped files (colon filenames break Windows)
lanes/broadcast/hygiene/
lanes/broadcast/operator_alert_*.json
lanes/broadcast/quarantine/

# Backup directories (timestamped)
backup_*/
