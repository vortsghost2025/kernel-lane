# === AI Review Router — 4-Tier Config ===
# All keys are gitignored. Copy this to .env and fill in your values.

# Tier 1: Local Ollama (your GPU, $0)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Tier 2: NVIDIA NIM Cloud (free beta, $0)
NVIDIA_NIM_API_KEY=nvapi-replace-with-your-key
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=google/gemma-2-2b-it

# Tier 3: OpenRouter Free Cloud ($0)
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MODEL_FALLBACK=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Tier 4: Manual (no API key needed — you use Claude/GPT yourself)
